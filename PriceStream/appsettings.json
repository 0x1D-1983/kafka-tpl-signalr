{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "epex-market-data",
    "ConsumerGroupId": "pricestream-signalr"
  },
  "Redis": {
    "Configuration": "",
    "InstanceName": "pricestream"
  },
  "Subscriptions": {
    "AllowedSymbols": [],
    "SymbolPattern": "^[A-Z0-9][A-Z0-9_-]*$",
    "MaxSymbolLength": 16,
    "MaxSymbolsPerConnection": 50,
    "CallsPerWindow": 10,
    "WindowSeconds": 10
  }
}
