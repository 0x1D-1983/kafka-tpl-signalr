{
  "uid": "pricestream",
  "title": "PriceStream",
  "description": "Kafka → TPL Dataflow → SignalR. Every pod reads the whole topic, so Kafka-side series should match across pods.",
  "tags": ["pricestream"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(pricestream_kafka_messages_total, pod)", "refId": "pod" },
        "definition": "label_values(pricestream_kafka_messages_total, pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Consumed / s (per pod)",
      "description": "Average across the selected pods. Each pod reads the full topic, so this is the topic rate.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "avg(sum by (pod) (rate(pricestream_kafka_messages_total{pod=~\"$pod\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Parse failures / s",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pricestream_kafka_messages_failed_total{pod=~\"$pod\"}[$__rate_interval])) or vector(0)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dropped / s",
      "description": "Parsed messages not delivered: pipeline backpressure, missing symbol or SignalR send failure.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pricestream_messages_dropped_total{pod=~\"$pod\"}[$__rate_interval])) or vector(0)" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Publish latency p99",
      "description": "Kafka message timestamp to the send to one client completed, per delivered tick. Includes clock skew between producer and pod.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(pricestream_publish_latency_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active connections",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(signalr_server_active_connections{pod=~\"$pod\"}) or vector(0)" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Max consumer lag",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 100 }, { "color": "red", "value": 1000 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "max(pricestream_kafka_consumer_lag{pod=~\"$pod\"})" }
      ]
    },
    { "id": 100, "type": "row", "title": "Kafka ingest", "collapsed": false, "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Messages consumed / parsed / failed",
      "description": "Per pod. Consumed includes the startup replay; parsed + failed = consumed.",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (rate(pricestream_kafka_messages_total{pod=~\"$pod\"}[$__rate_interval]))", "legendFormat": "{{pod}} consumed" },
        { "refId": "B", "expr": "sum by (pod) (rate(pricestream_kafka_messages_parsed_total{pod=~\"$pod\"}[$__rate_interval]))", "legendFormat": "{{pod}} parsed" },
        { "refId": "C", "expr": "sum by (pod) (rate(pricestream_kafka_messages_failed_total{pod=~\"$pod\"}[$__rate_interval]))", "legendFormat": "{{pod}} failed" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Messages dropped by reason",
      "description": "backpressure: pipeline queue full when the consumer posted. no_symbol: posted without a symbol. send_failed: a send to one client threw. superseded: a slow client's pending tick replaced by a newer one for the same symbol (that client skips a price, nobody else is affected).",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "drawStyle": "bars" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (pod, reason) (rate(pricestream_messages_dropped_total{pod=~\"$pod\"}[$__rate_interval]))", "legendFormat": "{{pod}} {{reason}}" },
        { "refId": "B", "expr": "sum by (pod) (rate(pricestream_outbox_superseded_total{pod=~\"$pod\"}[$__rate_interval]))", "legendFormat": "{{pod}} superseded" }
      ]
    },
    { "id": 101, "type": "row", "title": "Pipeline", "collapsed": false, "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "queue holds up to 1000 (then the consumer drops) and fanout up to 500; both should stay near 0. outboxes is the pending ticks across all client outboxes, at most one per symbol per client; a slow client grows it without blocking the others.",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "max by (pod, stage) (pricestream_pipeline_queue_depth{pod=~\"$pod\"})", "legendFormat": "{{pod}} {{stage}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Publish latency (Kafka timestamp → SignalR send)",
      "description": "Live messages only; the startup replay is cached, not sent. Includes clock skew between producer and pod.",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(pricestream_publish_latency_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(pricestream_publish_latency_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(pricestream_publish_latency_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])))", "legendFormat": "p99" },
        { "refId": "D", "expr": "histogram_quantile(0.99, sum by (pod, le) (rate(pricestream_publish_latency_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])))", "legendFormat": "{{pod}} p99" }
      ]
    },
    { "id": 102, "type": "row", "title": "Clients", "collapsed": false, "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Active SignalR connections",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (signalr_server_active_connections{pod=~\"$pod\"})", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Subscriptions per symbol",
      "description": "Connections subscribed to each symbol, summed over the selected pods.",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "sort_desc(sum by (symbol) (pricestream_subscriptions{pod=~\"$pod\"}))", "legendFormat": "{{symbol}}", "instant": true }
      ]
    },
    { "id": 103, "type": "row", "title": "Kafka consumer", "collapsed": false, "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Consumer lag by partition",
      "description": "High watermark minus position, from the consumer's last fetch. Every pod reads every partition.",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "max by (pod, partition) (pricestream_kafka_consumer_lag{pod=~\"$pod\"})", "legendFormat": "{{pod}} p{{partition}}" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Kafka data age",
      "description": "Seconds since each pod last received a Kafka message, as of the last scrape (so up to 15s even when healthy). PriceStreamPodDataStale fires when one pod exceeds 60s while another is under 30s.",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 5, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 60 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "max by (pod) (time() - pricestream_kafka_last_message_time_seconds{pod=~\"$pod\"})", "legendFormat": "{{pod}}" }
      ]
    }
  ]
}
